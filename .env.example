# Copy to .env and adjust. No private keys belong in this file.
# The wallet key is generated at ~/.config/elysium-minute-loop/wallet.json and never leaves that file.

# Docker Compose: the Tailscale address the dashboard binds to (required by compose.yaml).
DASHBOARD_BIND_IP=100.64.0.1

# Live writes stay off unless this is exactly true and the command has --live.
ELYSIUM_LIVE_ENABLED=false

# Optional: override the journal directory (absolute path). Defaults to ~/.local/state/elysium-minute-loop,
# or ~/.local/state/elysium-minute-loop-hyperevm with --chain hyperevm-testnet.
# ELYSIUM_STATE_DIR=

# Conservative testnet cost controls, in wei.
ELYSIUM_MAX_GAS=300000
ELYSIUM_MAX_FEE_PER_GAS=5000000000
ELYSIUM_MAX_TX_COST=1000000000000000
ELYSIUM_MIN_GAS_RESERVE=10000000000000000
ELYSIUM_DAILY_COST_LIMIT=10000000000000000
